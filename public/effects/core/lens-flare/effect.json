{
  "id": "lens-flare",
  "name": "Lens Flare Burst",
  "category": "Light",
  "description": "An anamorphic flare: magenta wash, green streaks and a hot core that burst on the drive. Can follow the subject when a mask exists.",
  "tags": ["flare", "anamorphic", "burst", "light", "timewarp"],
  "audio": true,
  "uniforms": {
    "position":  { "type": "vec2", "default": [0.7, 0.75], "min": 0, "max": 1, "label": "position" },
    "follow":    { "type": "bool", "default": 0, "label": "follow subject" },
    "strength":  { "type": "float", "default": 0.25, "min": 0, "max": 1.5, "step": 0.01, "label": "base strength" },
    "audioPush": { "type": "float", "default": 0.9, "min": 0, "max": 2, "step": 0.01, "label": "audio burst" },
    "hue":       { "type": "float", "default": 0.3, "min": 0, "max": 1, "step": 0.01, "label": "wash hue" }
  }
}
