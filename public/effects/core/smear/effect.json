{
  "id": "smear",
  "name": "Smear",
  "category": "Blur",
  "description": "Directional streak blur that drags the image like a fast camera whip. Audio lengthens the smear.",
  "tags": ["smear", "streak", "motion", "whip", "timewarp"],
  "audio": true,
  "uniforms": {
    "streak":    { "type": "float", "default": 0.05, "min": 0, "max": 0.4, "step": 0.001, "label": "length" },
    "audioPush": { "type": "float", "default": 0.08, "min": 0, "max": 0.4, "step": 0.001, "label": "audio length" },
    "angle":     { "type": "float", "default": 1.5708, "min": 0, "max": 6.2832, "step": 0.01, "label": "direction" },
    "rgb":       { "type": "float", "default": 0.3, "min": 0, "max": 1, "step": 0.01, "label": "colour fringe" }
  }
}
