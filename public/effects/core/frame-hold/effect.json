{
  "id": "frame-hold",
  "name": "Choppy / Frame Hold",
  "category": "Temporal",
  "description": "Drops the frame rate by holding frames (stop-motion stutter). Audio drive can make it hold longer on hits.",
  "tags": ["stutter", "choppy", "hold", "stop-motion", "temporal", "history"],
  "audio": true,
  "needsHistory": true,
  "uniforms": {
    "hold":      { "type": "int", "default": 3, "min": 1, "max": 15, "step": 1, "label": "hold frames" },
    "audioPush": { "type": "float", "default": 0.0, "min": 0, "max": 1, "step": 0.01, "label": "audio extra hold" }
  }
}
