{
  "id": "thermal",
  "name": "Thermal Camera",
  "category": "Color",
  "description": "Heat-camera palette from brightness. With a mask, the subject runs hot and the background cold.",
  "tags": ["thermal", "heat", "infrared", "palette", "predator"],
  "audio": true,
  "uniforms": {
    "palette":     { "type": "enum", "options": ["ironbow", "rainbow", "white hot"], "default": 0, "label": "palette" },
    "contrast":    { "type": "float", "default": 1.3, "min": 0.3, "max": 3, "step": 0.01, "label": "contrast" },
    "subjectHeat": { "type": "float", "default": 0.6, "min": 0, "max": 1, "step": 0.01, "label": "subject heat (mask)" },
    "blur":        { "type": "float", "default": 2.0, "min": 0, "max": 8, "step": 0.1, "label": "sensor blur (px @1080)" },
    "audioPush":   { "type": "float", "default": 0.25, "min": 0, "max": 1, "step": 0.01, "label": "audio heat" }
  }
}
