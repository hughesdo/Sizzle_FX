{
  "id": "kick-zoom",
  "name": "Kick Zoom + Shake",
  "category": "Distort",
  "description": "Camera punches in and jolts on the drive (best with drive = kick hits).",
  "tags": ["zoom", "shake", "punch", "kick", "camera"],
  "audio": true,
  "uniforms": {
    "zoom":     { "type": "float", "default": 0.08, "min": 0, "max": 0.5, "step": 0.005, "label": "zoom punch" },
    "shake":    { "type": "float", "default": 0.012, "min": 0, "max": 0.06, "step": 0.001, "label": "shake" },
    "rotate":   { "type": "float", "default": 0.01, "min": 0, "max": 0.1, "step": 0.001, "label": "roll (rad)" },
    "baseZoom": { "type": "float", "default": 0.0, "min": 0, "max": 0.3, "step": 0.005, "label": "constant zoom" }
  }
}
