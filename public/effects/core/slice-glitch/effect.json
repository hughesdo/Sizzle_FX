{
  "id": "slice-glitch",
  "name": "Slice Glitch",
  "category": "Glitch",
  "description": "Horizontal bands of the frame tear sideways. More bands tear when the drive is loud.",
  "tags": ["glitch", "slice", "tear", "timewarp"],
  "audio": true,
  "uniforms": {
    "amount":    { "type": "float", "default": 0.25, "min": 0, "max": 1, "step": 0.01, "label": "base tear" },
    "audioPush": { "type": "float", "default": 0.8, "min": 0, "max": 2, "step": 0.01, "label": "audio push" },
    "bands":     { "type": "float", "default": 36, "min": 4, "max": 120, "step": 1, "label": "bands" },
    "rate":      { "type": "float", "default": 14, "min": 1, "max": 60, "step": 1, "label": "re-roll rate (Hz)" },
    "rgbTear":   { "type": "float", "default": 0.5, "min": 0, "max": 1, "step": 0.01, "label": "colour tear" }
  }
}
