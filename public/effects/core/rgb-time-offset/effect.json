{
  "id": "rgb-time-offset",
  "name": "RGB Time Offset",
  "category": "Temporal",
  "description": "Red shows now, green and blue show earlier frames, so anything that moves splits into colour.",
  "tags": ["rgb", "time", "delay", "split", "temporal", "history"],
  "audio": true,
  "needsHistory": true,
  "uniforms": {
    "delay":     { "type": "int", "default": 3, "min": 1, "max": 7, "step": 1, "label": "frames per channel" },
    "audioPush": { "type": "float", "default": 0.0, "min": 0, "max": 1, "step": 0.01, "label": "audio extra delay" },
    "order":     { "type": "enum", "options": ["R now, G, B late", "B now, G, R late"], "default": 0, "label": "order" }
  }
}
