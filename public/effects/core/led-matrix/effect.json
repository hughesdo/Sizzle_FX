{
  "id": "led-matrix",
  "name": "LED Wall",
  "category": "Stylize",
  "description": "The video shown on a dot-matrix LED screen. Dark pixels switch off.",
  "tags": ["led", "dot", "matrix", "screen", "timewarp"],
  "audio": true,
  "uniforms": {
    "cell":      { "type": "float", "default": 9, "min": 3, "max": 40, "step": 0.5, "label": "cell size (px @1080)" },
    "threshold": { "type": "float", "default": 0.12, "min": 0, "max": 0.6, "step": 0.01, "label": "off threshold" },
    "boost":     { "type": "float", "default": 1.3, "min": 0.5, "max": 3, "step": 0.05, "label": "brightness" },
    "audioPush": { "type": "float", "default": 0.5, "min": 0, "max": 2, "step": 0.01, "label": "audio flare" }
  }
}
