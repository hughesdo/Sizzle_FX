    "strength":  { "type": "float", "default": 0.6, "min": 0, "max": 2, "step": 0.01, "label": "strength" },
    "tint":      { "type": "color", "default": "#ff4a1a", "label": "tint" },
    "audioPush": { "type": "float", "default": 0.0, "min": 0, "max": 2, "step": 0.01, "label": "audio" }
  }
