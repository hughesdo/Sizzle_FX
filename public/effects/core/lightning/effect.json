{
  "id": "lightning",
  "name": "Lightning Bolt",
  "category": "Light",
  "description": "A forked electric bolt that re-strikes many times a second while the drive is high (use kick or snare).",
  "tags": ["lightning", "bolt", "electric", "strike", "timewarp"],
  "audio": true,
  "uniforms": {
    "threshold": { "type": "float", "default": 0.3, "min": 0, "max": 1, "step": 0.01, "label": "strike above" },
    "strength":  { "type": "float", "default": 1.2, "min": 0, "max": 3, "step": 0.01, "label": "brightness" },
    "rate":      { "type": "float", "default": 20, "min": 2, "max": 60, "step": 1, "label": "re-strike rate (Hz)" },
    "tilt":      { "type": "float", "default": -0.7, "min": -1.6, "max": 1.6, "step": 0.01, "label": "angle" },
    "color":     { "type": "color", "default": "#d9ebff", "label": "colour" },
    "always":    { "type": "bool", "default": 0, "label": "ignore audio" }
  }
}
