{
  "id": "mirror-echo",
  "name": "Mirror Echo",
  "category": "Distort",
  "description": "Squeezed horizontal reflections of the frame stacked behind it in a cool tint, like a hall of mirrors.",
  "tags": ["mirror", "echo", "reflection", "timewarp"],
  "audio": true,
  "uniforms": {
    "amount":    { "type": "float", "default": 0.7, "min": 0, "max": 1, "step": 0.01, "label": "amount" },
    "squeeze":   { "type": "float", "default": 0.6, "min": 0.1, "max": 0.95, "step": 0.01, "label": "squeeze" },
    "copies":    { "type": "int", "default": 2, "min": 1, "max": 5, "step": 1, "label": "echoes" },
    "tint":      { "type": "color", "default": "#b3ccff", "label": "tint" },
    "audioPush": { "type": "float", "default": 0.3, "min": 0, "max": 1, "step": 0.01, "label": "audio" }
  }
}
