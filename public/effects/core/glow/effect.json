{
  "id": "glow",
  "name": "Glow",
  "category": "Light",
  "description": "Soft bloom around bright areas. Audio drive swells it.",
  "tags": ["bloom", "glow", "halation", "light"],
  "audio": true,
  "uniforms": {
    "threshold": { "type": "float", "default": 0.6, "min": 0, "max": 1, "step": 0.01, "label": "threshold" },
    "radius":    { "type": "float", "default": 18, "min": 2, "max": 60, "step": 0.5, "label": "radius (px @1080)" },
    "strength":  { "type": "float", "default": 0.8, "min": 0, "max": 3, "step": 0.01, "label": "strength" },
    "audioPush": { "type": "float", "default": 0.8, "min": 0, "max": 3, "step": 0.01, "label": "audio swell" },
    "tint":      { "type": "color", "default": "#ffe2c4", "label": "tint" }
  }
}
