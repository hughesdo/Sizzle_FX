{
  "id": "subject-afterimage",
  "name": "Subject Afterimage",
  "category": "Body",
  "description": "Fading, tinted copies of the subject from the last frames trail behind them. Only the subject leaves a trail, the background stays clean.",
  "tags": ["afterimage", "trail", "ghost", "motion", "matte", "history"],
  "audio": true,
  "needsMask": true,
  "needsHistory": true,
  "uniforms": {
    "count":     { "type": "int", "default": 5, "min": 1, "max": 15, "step": 1, "label": "ghosts" },
    "spacing":   { "type": "int", "default": 2, "min": 1, "max": 5, "step": 1, "label": "frames apart" },
    "decay":     { "type": "float", "default": 0.75, "min": 0.1, "max": 0.98, "step": 0.01, "label": "decay" },
    "tint":      { "type": "color", "default": "#7aa2ff", "label": "tint" },
    "tintAmt":   { "type": "float", "default": 0.5, "min": 0, "max": 1, "step": 0.01, "label": "tint amount" },
    "audioPush": { "type": "float", "default": 0.2, "min": 0, "max": 1, "step": 0.01, "label": "audio sustain" }
  }
}
