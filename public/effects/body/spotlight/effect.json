{
  "id": "spotlight",
  "name": "Spotlight",
  "category": "Body",
  "description": "Drains colour and light from the background so the subject pops, with an optional pool of light that follows them.",
  "tags": ["spotlight", "desaturate", "isolate", "pop", "matte"],
  "audio": true,
  "needsMask": true,
  "uniforms": {
    "desat":     { "type": "float", "default": 1.0, "min": 0, "max": 1, "step": 0.01, "label": "background desaturate" },
    "darken":    { "type": "float", "default": 0.45, "min": 0, "max": 1, "step": 0.01, "label": "background darken" },
    "pool":      { "type": "float", "default": 0.5, "min": 0, "max": 1, "step": 0.01, "label": "light pool" },
    "poolSize":  { "type": "float", "default": 0.45, "min": 0.1, "max": 1.5, "step": 0.01, "label": "pool size" },
    "boost":     { "type": "float", "default": 1.1, "min": 0.5, "max": 2, "step": 0.01, "label": "subject boost" },
    "audioPush": { "type": "float", "default": 0.3, "min": 0, "max": 2, "step": 0.01, "label": "audio pool" }
  }
}
