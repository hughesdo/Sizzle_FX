{
  "id": "st-radial-blur",
  "name": "Radial Blur",
  "category": "Blur",
  "kind": "filter",
  "description": "SuperTool: radial, blur, zoom, vignette",
  "tags": [
    "radial",
    "blur",
    "zoom",
    "vignette",
    "supertool"
  ],
  "audio": true,
  "passes": [
    {
      "name": "Image",
      "file": "main.glsl",
      "channels": {
        "iChannel0": "input"
      }
    }
  ],
  "uniforms": {
    "baseBlurStrength": {
      "type": "float",
      "default": 0.01,
      "label": "baseBlurStrength",
      "min": 0,
      "max": 0.1,
      "step": 0.001,
      "description": "Radial blur strength at silence"
    },
    "audioBlurStrength": {
      "type": "float",
      "default": 0.03,
      "label": "audioBlurStrength",
      "min": 0,
      "max": 0.15,
      "step": 0.005,
      "description": "Extra blur added by the bass band"
    },
    "blurSamples": {
      "type": "float",
      "default": 12,
      "label": "blurSamples",
      "min": 4,
      "max": 32,
      "step": 1,
      "description": "Sample count (higher = smoother but slower)"
    },
    "colorShift": {
      "type": "float",
      "default": 0.3,
      "label": "colorShift",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "RGB channel-shuffle amount driven by mids"
    },
    "vignetteStrength": {
      "type": "float",
      "default": 0.5,
      "label": "vignetteStrength",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "description": "Edge darkening strength"
    },
    "centerX": {
      "type": "float",
      "default": 0.5,
      "label": "centerX",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Horizontal blur center"
    },
    "centerY": {
      "type": "float",
      "default": 0.5,
      "label": "centerY",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Vertical blur center"
    }
  }
}
