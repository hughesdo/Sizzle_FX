{
  "id": "st-digital-glitch",
  "name": "Digital Glitch",
  "category": "Glitch",
  "kind": "filter",
  "description": "SuperTool: glitch, digital, scanline, chromatic",
  "tags": [
    "glitch",
    "digital",
    "scanline",
    "chromatic",
    "supertool"
  ],
  "audio": true,
  "passes": [
    {
      "name": "Image",
      "file": "main.glsl",
      "channels": {
        "iChannel0": "input"
      }
    }
  ],
  "uniforms": {
    "glitchFrequency": {
      "type": "float",
      "default": 10,
      "label": "glitchFrequency",
      "min": 1,
      "max": 30,
      "step": 1,
      "description": "How often glitches occur (Hz)"
    },
    "glitchThreshold": {
      "type": "float",
      "default": 0.9,
      "label": "glitchThreshold",
      "min": 0.5,
      "max": 1,
      "step": 0.05,
      "description": "Random threshold to trigger a glitch (lower = more)"
    },
    "displacementAmount": {
      "type": "float",
      "default": 0.1,
      "label": "displacementAmount",
      "min": 0,
      "max": 0.5,
      "step": 0.01,
      "description": "Horizontal scanline displacement"
    },
    "chromaticShift": {
      "type": "float",
      "default": 0.02,
      "label": "chromaticShift",
      "min": 0,
      "max": 0.1,
      "step": 0.005,
      "description": "RGB separation during a glitch"
    },
    "audioSensitivity": {
      "type": "float",
      "default": 1,
      "label": "audioSensitivity",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "description": "How much audio raises glitch intensity"
    }
  }
}
