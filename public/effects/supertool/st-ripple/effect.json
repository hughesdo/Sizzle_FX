{
  "id": "st-ripple",
  "name": "Ripple",
  "category": "Overlay",
  "kind": "overlay",
  "description": "SuperTool: ripple, water, distortion, rings",
  "tags": [
    "ripple",
    "water",
    "distortion",
    "rings",
    "supertool"
  ],
  "audio": true,
  "passes": [
    {
      "name": "Image",
      "file": "main.glsl",
      "channels": {
        "iChannel0": "input"
      }
    }
  ],
  "uniforms": {
    "rippleFrequency": {
      "type": "float",
      "default": 30,
      "label": "rippleFrequency",
      "min": 5,
      "max": 100,
      "step": 1,
      "description": "Number of concentric ripple rings"
    },
    "rippleSpeed": {
      "type": "float",
      "default": 5,
      "label": "rippleSpeed",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "description": "Outward speed of the ripples"
    },
    "baseAmplitude": {
      "type": "float",
      "default": 0.02,
      "label": "baseAmplitude",
      "min": 0,
      "max": 0.1,
      "step": 0.001,
      "description": "Ripple distortion at silence"
    },
    "audioAmplitude": {
      "type": "float",
      "default": 0.03,
      "label": "audioAmplitude",
      "min": 0,
      "max": 0.15,
      "step": 0.005,
      "description": "Extra distortion added by the bass band"
    },
    "centerX": {
      "type": "float",
      "default": 0.5,
      "label": "centerX",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Horizontal ripple center"
    },
    "centerY": {
      "type": "float",
      "default": 0.5,
      "label": "centerY",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Vertical ripple center"
    }
  }
}
