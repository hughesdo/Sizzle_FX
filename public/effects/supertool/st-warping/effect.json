{
  "id": "st-warping",
  "name": "Warping",
  "category": "Distort",
  "kind": "filter",
  "description": "SuperTool: warp, distortion, wave, radial",
  "tags": [
    "warp",
    "distortion",
    "wave",
    "radial",
    "supertool"
  ],
  "audio": false,
  "passes": [
    {
      "name": "Image",
      "file": "main.glsl",
      "channels": {
        "iChannel0": "input"
      }
    }
  ],
  "uniforms": {
    "warpMode": {
      "type": "float",
      "default": 0,
      "label": "warpMode",
      "min": 0,
      "max": 2,
      "step": 1,
      "description": "0=sine, 1=multi-layer, 2=radial"
    },
    "warpIntensity": {
      "type": "float",
      "default": 0.5,
      "label": "warpIntensity",
      "min": 0,
      "max": 3,
      "step": 0.05,
      "description": "Overall warp strength"
    },
    "warpFrequency": {
      "type": "float",
      "default": 3,
      "label": "warpFrequency",
      "min": 0.5,
      "max": 20,
      "step": 0.5,
      "description": "Spatial frequency of the warp"
    },
    "warpSpeed": {
      "type": "float",
      "default": 1,
      "label": "warpSpeed",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "description": "Animation speed of the warp"
    },
    "timeSpeed": {
      "type": "float",
      "default": 1,
      "label": "timeSpeed",
      "min": 0,
      "max": 4,
      "step": 0.05,
      "description": "Global time multiplier"
    },
    "layer1Amp": {
      "type": "float",
      "default": 0.5,
      "label": "layer1Amp",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "Amplitude of warp layer 1"
    },
    "layer2Amp": {
      "type": "float",
      "default": 0.25,
      "label": "layer2Amp",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "Amplitude of warp layer 2"
    },
    "layer3Amp": {
      "type": "float",
      "default": 0.125,
      "label": "layer3Amp",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "Amplitude of warp layer 3 (multi-layer mode)"
    },
    "layer4Amp": {
      "type": "float",
      "default": 0.0625,
      "label": "layer4Amp",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "Amplitude of warp layer 4 (multi-layer mode)"
    }
  }
}
