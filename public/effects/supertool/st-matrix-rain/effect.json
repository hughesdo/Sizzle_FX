{
  "id": "st-matrix-rain",
  "name": "Matrix Rain",
  "category": "Overlay",
  "kind": "overlay",
  "description": "SuperTool: matrix, rain, digital, overlay, audio",
  "tags": [
    "matrix",
    "rain",
    "digital",
    "overlay",
    "audio",
    "supertool"
  ],
  "audio": true,
  "passes": [
    {
      "name": "Image",
      "file": "main.glsl",
      "channels": {
        "iChannel0": "input"
      }
    }
  ],
  "uniforms": {
    "columnDensity": {
      "type": "float",
      "default": 20,
      "label": "columnDensity",
      "min": 5,
      "max": 50,
      "step": 1,
      "description": "Number of code columns"
    },
    "fallSpeed": {
      "type": "float",
      "default": 2,
      "label": "fallSpeed",
      "min": 0.5,
      "max": 10,
      "step": 0.5,
      "description": "Speed of falling code"
    },
    "characterDensity": {
      "type": "float",
      "default": 0.8,
      "label": "characterDensity",
      "min": 0.5,
      "max": 0.99,
      "step": 0.01,
      "description": "Density of characters (higher = more)"
    },
    "brightness": {
      "type": "float",
      "default": 1,
      "label": "brightness",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "description": "Brightness of code"
    },
    "audioBoost": {
      "type": "float",
      "default": 2,
      "label": "audioBoost",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "description": "Audio reactivity multiplier"
    },
    "videoDarken": {
      "type": "float",
      "default": 0.7,
      "label": "videoDarken",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "How much to darken video (0=black, 1=full)"
    },
    "rainIntensity": {
      "type": "float",
      "default": 1,
      "label": "rainIntensity",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "description": "Overall effect intensity"
    }
  }
}
