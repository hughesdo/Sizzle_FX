{
  "id": "st-scanning-lines",
  "name": "Scanning Lines",
  "category": "Overlay",
  "kind": "overlay",
  "description": "SuperTool: scanlines, retro, overlay, audio",
  "tags": [
    "scanlines",
    "retro",
    "overlay",
    "audio",
    "supertool"
  ],
  "audio": true,
  "passes": [
    {
      "name": "Image",
      "file": "main.glsl",
      "channels": {
        "iChannel0": "input"
      }
    }
  ],
  "uniforms": {
    "lineFrequency": {
      "type": "float",
      "default": 0.5,
      "label": "lineFrequency",
      "min": 0.1,
      "max": 2,
      "step": 0.1,
      "description": "Density of scanning lines"
    },
    "lineSpeed": {
      "type": "float",
      "default": 10,
      "label": "lineSpeed",
      "min": 0,
      "max": 50,
      "step": 1,
      "description": "Animation speed"
    },
    "lineSharpness": {
      "type": "float",
      "default": 3,
      "label": "lineSharpness",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "description": "Edge sharpness of lines"
    },
    "lineIntensity": {
      "type": "float",
      "default": 1,
      "label": "lineIntensity",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "description": "Brightness of lines"
    },
    "audioBoost": {
      "type": "float",
      "default": 1,
      "label": "audioBoost",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "description": "Audio reactivity multiplier"
    },
    "lineColor": {
      "type": "color",
      "default": [
        0.2,
        1,
        0.5
      ],
      "label": "lineColor",
      "description": "RGB color of lines"
    }
  }
}
