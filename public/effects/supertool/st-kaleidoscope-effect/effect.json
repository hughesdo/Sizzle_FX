{
  "id": "st-kaleidoscope-effect",
  "name": "Kaleidoscope (Effect)",
  "category": "Distort",
  "kind": "filter",
  "description": "SuperTool: kaleidoscope, mirror, symmetry, geometric",
  "tags": [
    "kaleidoscope",
    "mirror",
    "symmetry",
    "geometric",
    "supertool"
  ],
  "audio": true,
  "passes": [
    {
      "name": "Image",
      "file": "main.glsl",
      "channels": {
        "iChannel0": "input"
      }
    }
  ],
  "uniforms": {
    "baseSegments": {
      "type": "float",
      "default": 6,
      "label": "baseSegments",
      "min": 2,
      "max": 12,
      "step": 1,
      "description": "Number of mirrored wedges"
    },
    "audioSegments": {
      "type": "float",
      "default": 6,
      "label": "audioSegments",
      "min": 0,
      "max": 12,
      "step": 1,
      "description": "Extra wedges added by the bass band"
    },
    "rotation": {
      "type": "float",
      "default": 0,
      "label": "rotation",
      "min": 0,
      "max": 6.28318,
      "step": 0.1,
      "description": "Static rotation offset (radians)"
    },
    "rotationSpeed": {
      "type": "float",
      "default": 0,
      "label": "rotationSpeed",
      "min": -2,
      "max": 2,
      "step": 0.1,
      "description": "Continuous spin speed (negative = reverse)"
    },
    "zoom": {
      "type": "float",
      "default": 1,
      "label": "zoom",
      "min": 0.1,
      "max": 3,
      "step": 0.05,
      "description": "Zoom into the mirrored pattern"
    }
  }
}
