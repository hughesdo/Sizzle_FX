{
  "id": "st-audio-ripples",
  "name": "Audio Ripples",
  "category": "Overlay",
  "kind": "overlay",
  "description": "SuperTool: ripple, audio, rings, distortion",
  "tags": [
    "ripple",
    "audio",
    "rings",
    "distortion",
    "supertool"
  ],
  "audio": true,
  "passes": [
    {
      "name": "Image",
      "file": "main.glsl",
      "channels": {
        "iChannel0": "input"
      }
    }
  ],
  "uniforms": {
    "rippleIntensity": {
      "type": "float",
      "default": 1.2,
      "label": "rippleIntensity",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "description": "Overall ripple amplitude"
    },
    "rippleFrequency": {
      "type": "float",
      "default": 40,
      "label": "rippleFrequency",
      "min": 5,
      "max": 100,
      "step": 1,
      "description": "Number of ripple rings"
    },
    "rippleSpeed": {
      "type": "float",
      "default": 8,
      "label": "rippleSpeed",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "description": "Outward speed of the ripples"
    },
    "centerX": {
      "type": "float",
      "default": 0.5,
      "label": "centerX",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Horizontal ripple center"
    },
    "centerY": {
      "type": "float",
      "default": 0.5,
      "label": "centerY",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Vertical ripple center"
    },
    "multiRipple": {
      "type": "float",
      "default": 0,
      "label": "multiRipple",
      "min": 0,
      "max": 1,
      "step": 1,
      "description": "0=single ripple set, 1=add a second harmonic set"
    },
    "timeSpeed": {
      "type": "float",
      "default": 1,
      "label": "timeSpeed",
      "min": 0,
      "max": 4,
      "step": 0.05,
      "description": "Global animation speed"
    }
  }
}
