{
  "id": "st-dolly-zoom",
  "name": "Dolly Zoom",
  "category": "Distort",
  "kind": "filter",
  "description": "SuperTool: dolly, vertigo, zoom, vignette, cinematic",
  "tags": [
    "dolly",
    "vertigo",
    "zoom",
    "vignette",
    "cinematic",
    "supertool"
  ],
  "audio": true,
  "passes": [
    {
      "name": "Image",
      "file": "main.glsl",
      "channels": {
        "iChannel0": "input"
      }
    }
  ],
  "uniforms": {
    "zoomSpeed": {
      "type": "float",
      "default": 2,
      "label": "zoomSpeed",
      "min": 0,
      "max": 10,
      "step": 0.1,
      "description": "Speed of the zoom oscillation"
    },
    "zoomIntensity": {
      "type": "float",
      "default": 0.3,
      "label": "zoomIntensity",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "Strength of the zoom (plus bass push-in)"
    },
    "rotationIntensity": {
      "type": "float",
      "default": 0.1,
      "label": "rotationIntensity",
      "min": 0,
      "max": 0.5,
      "step": 0.01,
      "description": "Bass-driven rotation amount"
    },
    "vignetteStrength": {
      "type": "float",
      "default": 0.8,
      "label": "vignetteStrength",
      "min": 0,
      "max": 1.5,
      "step": 0.05,
      "description": "Edge-vignette darkness"
    },
    "vignetteSize": {
      "type": "float",
      "default": 0.3,
      "label": "vignetteSize",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "Size of the clear center area"
    },
    "centerX": {
      "type": "float",
      "default": 0.5,
      "label": "centerX",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Horizontal zoom center"
    },
    "centerY": {
      "type": "float",
      "default": 0.5,
      "label": "centerY",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Vertical zoom center"
    }
  }
}
