{
  "id": "st-pulsing-waves",
  "name": "Pulsing Waves",
  "category": "Overlay",
  "kind": "overlay",
  "description": "SuperTool: waves, pulse, overlay, audio",
  "tags": [
    "waves",
    "pulse",
    "overlay",
    "audio",
    "supertool"
  ],
  "audio": true,
  "passes": [
    {
      "name": "Image",
      "file": "main.glsl",
      "channels": {
        "iChannel0": "input"
      }
    }
  ],
  "uniforms": {
    "waveFrequency": {
      "type": "float",
      "default": 10,
      "label": "waveFrequency",
      "min": 2,
      "max": 30,
      "step": 1,
      "description": "Number of wave rings"
    },
    "waveSpeed": {
      "type": "float",
      "default": 5,
      "label": "waveSpeed",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "description": "Wave animation speed"
    },
    "audioModulation": {
      "type": "float",
      "default": 10,
      "label": "audioModulation",
      "min": 0,
      "max": 30,
      "step": 1,
      "description": "Audio effect on waves"
    },
    "waveSharpness": {
      "type": "float",
      "default": 3,
      "label": "waveSharpness",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "description": "Edge sharpness of waves"
    },
    "waveIntensity": {
      "type": "float",
      "default": 1,
      "label": "waveIntensity",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "description": "Brightness of waves"
    },
    "audioBoost": {
      "type": "float",
      "default": 1,
      "label": "audioBoost",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "description": "Audio reactivity multiplier"
    },
    "blendAmount": {
      "type": "float",
      "default": 0.5,
      "label": "blendAmount",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "Blend with video"
    },
    "waveColor": {
      "type": "color",
      "default": [
        0.3,
        0.8,
        1
      ],
      "label": "waveColor",
      "description": "RGB color of waves"
    }
  }
}
