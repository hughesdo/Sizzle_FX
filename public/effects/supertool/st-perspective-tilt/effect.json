{
  "id": "st-perspective-tilt",
  "name": "Perspective Tilt",
  "category": "Blur",
  "kind": "filter",
  "description": "SuperTool: tilt-shift, perspective, depth-of-field, blur",
  "tags": [
    "tilt-shift",
    "perspective",
    "depth-of-field",
    "blur",
    "supertool"
  ],
  "audio": true,
  "passes": [
    {
      "name": "Image",
      "file": "main.glsl",
      "channels": {
        "iChannel0": "input"
      }
    }
  ],
  "uniforms": {
    "baseTiltAngle": {
      "type": "float",
      "default": 0,
      "label": "baseTiltAngle",
      "min": -1,
      "max": 1,
      "step": 0.05,
      "description": "Static perspective tilt angle"
    },
    "audioTiltAngle": {
      "type": "float",
      "default": 0.5,
      "label": "audioTiltAngle",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "description": "Extra tilt added by the bass band"
    },
    "tiltCenter": {
      "type": "float",
      "default": 0.5,
      "label": "tiltCenter",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "Vertical center of the tilt/focus plane"
    },
    "horizontalShift": {
      "type": "float",
      "default": 0.3,
      "label": "horizontalShift",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "Horizontal skew amount"
    },
    "blurIntensity": {
      "type": "float",
      "default": 1,
      "label": "blurIntensity",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "description": "Depth-of-field blur strength"
    },
    "blurStart": {
      "type": "float",
      "default": 0.1,
      "label": "blurStart",
      "min": 0,
      "max": 0.5,
      "step": 0.05,
      "description": "Distance from focus where blur begins"
    },
    "blurEnd": {
      "type": "float",
      "default": 0.8,
      "label": "blurEnd",
      "min": 0.5,
      "max": 1,
      "step": 0.05,
      "description": "Distance from focus where blur is maximum"
    }
  }
}
