{
  "id": "st-easy-beats",
  "name": "Easy Beats",
  "category": "Distort",
  "kind": "filter",
  "description": "SuperTool: beat, shake, colorpop, sparkle, audio",
  "tags": [
    "beat",
    "shake",
    "colorpop",
    "sparkle",
    "audio",
    "supertool"
  ],
  "audio": true,
  "passes": [
    {
      "name": "Image",
      "file": "main.glsl",
      "channels": {
        "iChannel0": "input"
      }
    }
  ],
  "uniforms": {
    "intensity": {
      "type": "float",
      "default": 1,
      "label": "intensity",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "description": "Overall effect strength (0.0=off, 1.0=normal, 2.0=intense)"
    },
    "shakeAmount": {
      "type": "float",
      "default": 0.8,
      "label": "shakeAmount",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "Screen shake on kicks (0.0=no shake, 1.0=strong shake)"
    },
    "colorPop": {
      "type": "float",
      "default": 1,
      "label": "colorPop",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "Color enhancement on beats (0.0=none, 1.0=vibrant)"
    }
  }
}
