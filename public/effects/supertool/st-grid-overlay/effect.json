{
  "id": "st-grid-overlay",
  "name": "Grid Overlay",
  "category": "Overlay",
  "kind": "overlay",
  "description": "SuperTool: grid, overlay, audio",
  "tags": [
    "grid",
    "overlay",
    "audio",
    "supertool"
  ],
  "audio": true,
  "passes": [
    {
      "name": "Image",
      "file": "main.glsl",
      "channels": {
        "iChannel0": "input"
      }
    }
  ],
  "uniforms": {
    "gridSize": {
      "type": "float",
      "default": 20,
      "label": "gridSize",
      "min": 5,
      "max": 100,
      "step": 1,
      "description": "Number of grid cells"
    },
    "lineThickness": {
      "type": "float",
      "default": 0.1,
      "label": "lineThickness",
      "min": 0.01,
      "max": 0.5,
      "step": 0.01,
      "description": "Thickness of grid lines"
    },
    "gridIntensity": {
      "type": "float",
      "default": 1,
      "label": "gridIntensity",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "description": "Overall brightness of grid"
    },
    "audioBoost": {
      "type": "float",
      "default": 0.5,
      "label": "audioBoost",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "description": "Audio reactivity multiplier"
    },
    "gridColor": {
      "type": "color",
      "default": [
        1,
        0.5,
        0.8
      ],
      "label": "gridColor",
      "description": "RGB color of grid lines"
    }
  }
}
