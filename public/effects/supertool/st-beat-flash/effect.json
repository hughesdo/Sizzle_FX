{
  "id": "st-beat-flash",
  "name": "Beat Flash",
  "category": "Glitch",
  "kind": "filter",
  "description": "SuperTool: beat, flash, glitch, chromatic, audio",
  "tags": [
    "beat",
    "flash",
    "glitch",
    "chromatic",
    "audio",
    "supertool"
  ],
  "audio": true,
  "passes": [
    {
      "name": "Image",
      "file": "main.glsl",
      "channels": {
        "iChannel0": "input"
      }
    }
  ],
  "uniforms": {
    "beatSensitivity": {
      "type": "float",
      "default": 0.5,
      "label": "beatSensitivity",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "Beat trigger threshold (0.0-1.0)"
    },
    "flashStrength": {
      "type": "float",
      "default": 1.5,
      "label": "flashStrength",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "description": "Flash effect intensity (0.0-3.0)"
    },
    "flashDecay": {
      "type": "float",
      "default": 6,
      "label": "flashDecay",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "description": "Flash fade speed (1.0=slow, 10.0=fast)"
    },
    "chromaticOffset": {
      "type": "float",
      "default": 0.005,
      "label": "chromaticOffset",
      "min": 0,
      "max": 0.02,
      "step": 0.001,
      "description": "RGB separation amount (0.0-0.02)"
    },
    "exposureBoost": {
      "type": "float",
      "default": 1,
      "label": "exposureBoost",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "description": "Brightness flash intensity (0.0-3.0)"
    },
    "bloomIntensity": {
      "type": "float",
      "default": 0.3,
      "label": "bloomIntensity",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "White bloom strength (0.0-1.0)"
    },
    "posterizeLevel": {
      "type": "float",
      "default": 8,
      "label": "posterizeLevel",
      "min": 2,
      "max": 32,
      "step": 1,
      "description": "Digital burn levels (2.0-32.0)"
    },
    "timeSpeed": {
      "type": "float",
      "default": 1,
      "label": "timeSpeed",
      "min": 0.1,
      "max": 3,
      "step": 0.1,
      "description": "Animation speed (0.1-3.0)"
    }
  }
}
